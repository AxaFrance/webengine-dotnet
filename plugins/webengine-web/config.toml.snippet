# [mcp_servers.webengine-web]
# command = "dnx"
# args = ["AxaFrance.WebEngine.Mcp", "--profile", "web", "--transport", "stdio"]

# Skills: copy skills/webengine-web -> ~/.codex/skills/webengine-web
