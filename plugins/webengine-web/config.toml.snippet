# Codex CLI — copy into ~/.codex/config.toml (or .codex/config.toml for trusted projects)

[mcp_servers.webengine-web]
command = "dotnet"
args = ["exec", "D:/Projets/Github/webengine-dotnet/src/AxaFrance.WebEngine.Mcp/bin/Release/net10.0/AxaFrance.WebEngine.Mcp.dll", "--profile", "web", "--transport", "stdio"]

