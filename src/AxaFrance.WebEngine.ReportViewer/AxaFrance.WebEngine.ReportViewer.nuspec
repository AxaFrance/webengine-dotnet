<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AxaFrance.WebEngine.ReportViewer</id>
    <version>{{version}}</version>
    <authors>AxaFrance, Huaxing YUAN</authors>
    <projectUrl>https://github.com/AxaFrance/webengine-dotnet</projectUrl>
    <description>Report viewer executable for AXA WebEngine test reports.</description>
    <tags>AXA WebEngine Automation Framework</tags>
    <repository type="git" url="https://github.com/AxaFrance/webengine-dotnet" />
    <dependencies>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="AxaFrance.WebEngine" version="{{version}}" exclude="Build,Analyzers" />
        <dependency id="AvalonEdit" version="6.3.1.120" exclude="Build,Analyzers" />
        <dependency id="LiveChartsCore.SkiaSharpView.WPF" version="2.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Web.WebView2" version="1.0.4191.47" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <dependency id="AxaFrance.WebEngine" version="{{version}}" exclude="Build,Analyzers" />
        <dependency id="AvalonEdit" version="6.3.1.120" exclude="Build,Analyzers" />
        <dependency id="LiveChartsCore.SkiaSharpView.WPF" version="2.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Web.WebView2" version="1.0.4191.47" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>      
    </frameworkReferences>
    <contentFiles>
      <files include="any/net8.0-windows7.0/*.json" buildAction="None" copyToOutput="true" />
      <files include="any/net10.0-windows7.0/*.json" buildAction="None" copyToOutput="true" />
    </contentFiles>
  </metadata>
  <files>
    <!-- Include net8.0 -->
    <file src="net8.0-windows\ReportViewer.dll" target="lib\net8.0-windows7.0" />
    <file src="net8.0-windows\ReportViewer.exe" target="lib\net8.0-windows7.0" />
    <file src="net8.0-windows\ReportViewer.deps.json" target="contentFiles\any\net8.0-windows7.0" />
    <file src="net8.0-windows\ReportViewer.runtimeconfig.json" target="contentFiles\any\net8.0-windows7.0" />

    <!-- Include net10.0 -->
    <file src="net10.0-windows\ReportViewer.dll" target="lib\net10.0-windows7.0" />
    <file src="net10.0-windows\ReportViewer.exe" target="lib\net10.0-windows7.0" />
    <file src="net10.0-windows\ReportViewer.deps.json" target="contentFiles\any\net10.0-windows7.0" />
    <file src="net10.0-windows\ReportViewer.runtimeconfig.json" target="contentFiles\any\net10.0-windows7.0" />
  </files>
</package>