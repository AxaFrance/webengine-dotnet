<?xml version="1.0"?>
<package >
  <metadata>
    <id>AxaFrance.WebEngine.Runner</id>
    <version>{{version}}</version>
    <authors>AxaFrance, Huaxing YUAN</authors>
    <projectUrl>https://github.com/AxaFrance/webengine-dotnet</projectUrl>
    <description>WebRunner executable to run keyword driven automated tests.</description>
    <copyright>AXA France</copyright>
    <tags>AXA WebEngine Automation Framework</tags>
    <repository type="git" url="https://github.com/AxaFrance/webengine-dotnet" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="AxaFrance.WebEngine" version="{{version}}" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="AxaFrance.WebEngine" version="{{version}}" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/net8.0/*.json" buildAction="None" copyToOutput="true" />
      <files include="any/net10.0/*.json" buildAction="None" copyToOutput="true" />
    </contentFiles>
  </metadata>
  <files>
    <!-- Include net8.0 -->
    <file src="net8.0\WebRunner.dll" target="lib\net8.0" />
    <file src="net8.0\WebRunner.exe" target="lib\net8.0" />
    <file src="net8.0\WebRunner.deps.json" target="contentFiles\any\net8.0" />
    <file src="net8.0\WebRunner.runtimeconfig.json" target="contentFiles\any\net8.0" />

    <!-- Include net10.0 -->
    <file src="net10.0\WebRunner.dll" target="lib\net10.0" />
    <file src="net10.0\WebRunner.exe" target="lib\net10.0" />
    <file src="net10.0\WebRunner.deps.json" target="contentFiles\any\net10.0" />
    <file src="net10.0\WebRunner.runtimeconfig.json" target="contentFiles\any\net10.0" />
  </files>

</package>
